              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category L0 Expression"
          },
          "category_l1_literal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category L1 Literal"
          },
          "category_l1_expression": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category L1 Expression"
          },
          "category_l2_literal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
