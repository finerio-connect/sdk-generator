"""Configuration helper for SDK.

This module provides utilities to create SDK clients using environment variables,
making it easier to configure the SDK in different environments.

When running in AWS environments (Lambda, EC2, ECS, etc.), the SDK can automatically
use IAM credentials to sign requests to Lambda Function URLs with AWS_IAM auth.
"""

from __future__ import annotations

import os
from typing import Any
from urllib.parse import urlparse

import httpx_aws_auth
from httpx_aws_auth import AwsCredentials, AwsSigV4AuthSigner

from .client import {client_class}

try:
    import boto3
    from botocore.awsrequest import AWSRequest
    HAS_BOTO3 = True
except ImportError:
    HAS_BOTO3 = False


class AWSSigV4Auth(httpx_aws_auth.AwsSigV4Auth):
    """HTTPX Auth handler for AWS Signature Version 4.
    
    Automatically signs requests using AWS credentials from the environment
    (IAM role, environment variables, credentials file, etc.).
    
    This is used for authenticating requests to Lambda Function URLs with AWS_IAM auth.
    """
    
    def __init__(self, service: str = "lambda", region: str | None = None):
        """Initialize AWS SigV4 Auth handler.
        
        Args:
            service: AWS service name (default: "lambda")
            region: AWS region. If None, auto-detected from session or URL.
        """
        if not HAS_BOTO3:
            raise ImportError(
                "boto3 is required for AWS IAM authentication. "
                "Install it with: pip install boto3"
            )
        
        self.service = service
        self.session = boto3.Session()
        self._credentials = AwsCredentials(
            access_key=self.session.get_credentials().access_key,
            secret_key=self.session.get_credentials().secret_key,
            session_token=self.session.get_credentials().token
        )
        self._signer = AwsSigV4AuthSigner(service=service, region=region)
        self.region = region or self.session.region_name or "us-east-1"



def get_base_url() -> str:
    """Get the base URL from environment variable or return a default.

    Returns:
        The base URL from {env_var} env var,
        or "http://localhost:8000" as default.

    Raises:
        ValueError: If {env_var} is set but empty.
    """
    base_url = os.getenv("{env_var}")
    if base_url is None:
        return "http://localhost:8000"
    if not base_url.strip():
        raise ValueError("{env_var} is set but empty")
    return base_url.strip()


def _extract_region_from_url(url: str) -> str | None:
    """Extract AWS region from Lambda Function URL.
    
    Lambda Function URLs have the format:
    https://<url-id>.lambda-url.<region>.on.aws/
    """
    parsed = urlparse(url)
    hostname = parsed.hostname or ""
    
    if ".lambda-url." in hostname and ".on.aws" in hostname:
        parts = hostname.split(".")
        for i, part in enumerate(parts):
            if part == "lambda-url" and i + 1 < len(parts):
                return parts[i + 1]
    
    return None


def create_client(use_aws_auth: bool | None = None, **kwargs: Any) -> {client_class}:
    """Create a Client using environment variables for configuration.

    Environment variables:
        {env_var}: Base URL for the API (default: http://localhost:8000)
        {env_var}_USE_AWS_AUTH: Set to "true" to use AWS IAM authentication

    Args:
        use_aws_auth: If True, uses AWS IAM credentials to sign requests (for Lambda Function URLs).
                     If None, auto-detects based on URL or {env_var}_USE_AWS_AUTH env var.
        **kwargs: Additional arguments to pass to the Client constructor.
                 If 'base_url' is provided, it takes precedence over the env var.

    Returns:
        A configured Client instance with optional AWS IAM authentication.

    Example:
        >>> # Using environment variable
        >>> import os
        >>> os.environ["{env_var}"] = "https://api.example.com"
        >>> client = create_client()
        >>>
        >>> # Auto-detect AWS IAM auth for Lambda Function URLs
        >>> os.environ["{env_var}"] = "https://abc.lambda-url.us-east-1.on.aws/"
        >>> client = create_client()  # Automatically uses AWS IAM auth
        >>>
        >>> # Explicitly enable AWS IAM auth
        >>> client = create_client(use_aws_auth=True)
        >>>
        >>> # With additional configuration
        >>> client = create_client(timeout=30.0, verify_ssl=False)
    """
    # Extract base_url from kwargs or use default
    base_url = kwargs.pop("base_url", get_base_url())
    
    # Auto-detect if we should use AWS auth
    if use_aws_auth is None:
        env_aws_auth = os.getenv("{env_var}_USE_AWS_AUTH", "").lower()
        if env_aws_auth in ("true", "1", "yes"):
            use_aws_auth = True
        elif ".lambda-url." in base_url and ".on.aws" in base_url:
            # Auto-detect Lambda Function URL
            use_aws_auth = True
        else:
            use_aws_auth = False
    elif not isinstance(use_aws_auth, bool):
        # Normalize non-bool values
        use_aws_auth = bool(use_aws_auth)
    
    # Set up AWS IAM authentication if requested
    auth = None
    if use_aws_auth:
        if not HAS_BOTO3:
            raise ImportError(
                "boto3 is required for AWS IAM authentication. "
                "Install it with: pip install boto3"
            )
        
        region = _extract_region_from_url(base_url)
        auth = AWSSigV4Auth(service="lambda", region=region)
    
    return {client_class}(
        base_url=base_url,
        auth=auth,
        **kwargs
    )


def create_authenticated_client(
    token: str | None = None,
    use_aws_auth: bool = False,
    **kwargs: Any
) -> {client_class}:
    """Create a client with Bearer token authentication.

    Note: For Lambda Function URLs with AWS_IAM auth, use create_client() with use_aws_auth=True
    instead. This function is for traditional Bearer token authentication.

    Environment variables:
        {env_var}: Base URL for the API (default: http://localhost:8000)
        {env_var}_TOKEN: Authentication token (if not provided as argument)

    Args:
        token: Authentication token. If None, reads from {env_var}_TOKEN env var.
        use_aws_auth: If True, uses AWS IAM auth instead of Bearer token.
        **kwargs: Additional arguments to pass to {client_class}.

    Returns:
        A configured client instance with authentication.

    Raises:
        ValueError: If no token is provided and {env_var}_TOKEN is not set.

    Example:
        >>> import os
        >>> os.environ["{env_var}"] = "https://api.example.com"
        >>> os.environ["{env_var}_TOKEN"] = "my-secret-token"
        >>> client = create_authenticated_client()
    """
    base_url = kwargs.pop("base_url", get_base_url())
    
    auth = None
    if use_aws_auth:
        # Use AWS IAM authentication
        if not HAS_BOTO3:
            raise ImportError(
                "boto3 is required for AWS IAM authentication. "
                "Install it with: pip install boto3"
            )
        
        region = _extract_region_from_url(base_url)
        auth = AWSSigV4Auth(service="lambda", region=region)
    else:
        # Traditional Bearer token authentication
        if token is None:
            token = os.getenv("{env_var}_TOKEN")
            if not token:
                raise ValueError(
                    "No authentication token provided. "
                    "Pass 'token' argument or set {env_var}_TOKEN env var."
                )
        
        # Create simple Bearer auth for httpx
        headers = {{"Authorization": f"Bearer {{token}}"}}
        if "headers" in kwargs:
            kwargs["headers"].update(headers)
        else:
            kwargs["headers"] = headers

    return {client_class}(
        base_url=base_url,
        auth=auth,
        **kwargs
    )

